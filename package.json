{
  "name": "evolution-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node --import tsx scripts/check-core.ts",
    "test:engine": "vitest run",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "evolve": "node --import tsx scripts/evolve.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "benchmark:release": "node --import tsx scripts/benchmark-release.ts",
    "test:browser": "playwright test --project=chromium",
    "test:release": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
